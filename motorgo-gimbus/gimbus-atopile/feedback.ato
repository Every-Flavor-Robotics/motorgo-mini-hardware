#pragma experiment("FOR_LOOP")
#pragma experiment("BRIDGE_CONNECT")

import ElectricPower

from "parts/Magn_Tek_MT6701QT_STD/Magn_Tek_MT6701QT_STD.ato" import Magn_Tek_MT6701QT_STD_package

module FeedbackBlock:
    """
    Magnetic encoder feedback using MT6701QT-STD
    """
    enc = new Magn_Tek_MT6701QT_STD_package
    vcc_3v3 = new ElectricPower
    gnd = new ElectricPower

    # Power
    enc.VDD ~ vcc_3v3
    enc.GND ~ gnd

    # I2C connection (user to connect externally)
    # enc.PUSH ~ i2c_scl
    # enc.OUT ~ i2c_sda

    # Configuration pins
    enc.MODE ~ vcc_3v3
    # If CS is needed, add: enc.CS ~ vcc_3v3 (not present in this part) 