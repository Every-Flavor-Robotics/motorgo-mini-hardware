# mcu.ato
from "parts/Espressif_Systems_ESP32_S3_WROOM_1_N8/Espressif_Systems_ESP32_S3_WROOM_1_N8.ato" import Espressif_Systems_ESP32_S3_WROOM_1_N8_package as esp32

module MCUBlock:
    mcu = new esp32

    # --- Power ---
    power_3v3 = mcu.P3V3
    mcu.GND -> gnd

    # --- Communication Signals ---
    # USB OTG for programming
    usb_d_p = mcu.IO20
    usb_d_n = mcu.IO19

    # SPI for motor driver
    spi_sck = mcu.IO12
    spi_mosi = mcu.IO11
    spi_miso = mcu.IO13
    spi_cs = mcu.IO10

    # I2C for magnetic encoder
    i2c_scl = mcu.IO9
    i2c_sda = mcu.IO8

    # CAN bus to transceiver
    can_tx = mcu.IO5
    can_rx = mcu.IO4

    # --- Control Signals ---
    # PWM for motor driver
    pwm_a = mcu.IO1
    pwm_b = mcu.IO2
    pwm_c = mcu.IO3
    
    # Control signal for the USB MUX
    mux_select = mcu.IO18
    
    # Status LED
    led_pin = mcu.IO35 